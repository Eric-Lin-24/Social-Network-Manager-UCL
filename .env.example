# Community Curator - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# Microsoft OAuth (Azure AD)
# Get from: https://portal.azure.com/ > App registrations
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
# Get from: https://portal.azure.com/ > App registrations > your app > Application (client) ID

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Backend service URLs
# Telegram-Engine (messaging, port 8000)
AZURE_VM_URL=http://your-vm-ip:8000
# App-Backend (auth, workspaces, planning, port 8080)
AUTH_URL=http://your-vm-ip:8080